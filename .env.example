# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored (see *.local in .gitignore). Never commit real keys.
# Vite only reads env files at server startup — restart `npm run dev` after edits.

# Google Maps JavaScript API key.
# Create one in Google Cloud Console and RESTRICT it by HTTP referrer (your domains)
# to avoid billing abuse, since it ships in the client bundle.
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Supabase project URL and anon (publishable) key.
# Find them in: Supabase dashboard > Project Settings > API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
